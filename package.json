{
    "name": "db-exchange-silo-service",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --collect-coverage --passWithNoTests --testPathPattern=tests/unit-tests/",
        "build": "rimraf lib && tsc",
        "dev": "node lib/index.js"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "lib/**"
    ],
    "dependencies": {
        "@ldb/logger": "1.0.0",
        "@ldb/mongo": "6.8.0",
        "@ldb/scheduler": "3.0.1",
        "@ldb/sentry-logger": "1.0.0",
        "@ldb/skynex-logger": "1.0.0",
        "@ldb/terminal-logger": "1.0.0",
        "@ldb/types": "1.1.0",
        "awilix": "10.0.2",
        "mssql": "11.0.1"
    },
    "devDependencies": {
        "@commitlint/cli": "19.4.0",
        "@commitlint/config-conventional": "19.2.2",
        "@eslint/eslintrc": "3.1.0",
        "@eslint/js": "9.9.0",
        "@jest/globals": "29.7.0",
        "@ldb/base-logger": "1.0.0",
        "@tsconfig/node20": "20.1.4",
        "@types/jest": "29.5.12",
        "@types/mssql": "9.1.5",
        "@types/node": "22.2.0",
        "eslint": "9.9.0",
        "eslint-config-google": "0.14.0",
        "eslint-plugin-prettier": "5.2.1",
        "eslint-plugin-security": "3.0.1",
        "jest": "29.7.0",
        "jest-extended": "4.0.2",
        "jest-html-reporters": "3.1.7",
        "jest-junit": "16.0.0",
        "jest-sonar-reporter": "2.0.0",
        "rimraf": "6.0.1",
        "ts-jest": "29.2.4",
        "ts-node": "10.9.2",
        "typescript": "5.5.4",
        "typescript-eslint": "8.1.0"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
