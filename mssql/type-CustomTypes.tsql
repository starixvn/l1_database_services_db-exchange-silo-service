USE SabaWH;
GO
CREATE TYPE t.Exchange AS TABLE (
	exchangeid		INT				NOT NULL	PRIMARY KEY NONCLUSTERED,
	currency		NVARCHAR(50)	NOT NULL,
	Code			VARCHAR(12)		NULL,
	Description		VARCHAR(100)	NULL,
	MultipliedBy	DECIMAL(19, 8)	NULL,
	ExVirtualRate	FLOAT			NULL,
	IsActive		BIT				NOT NULL,
) WITH ( MEMORY_OPTIMIZED = ON );
GO
CREATE TYPE t.ExchangeOANDA AS TABLE (
	ExchangeDate	SMALLDATETIME	NOT NULL,
	ExchangeId		INT				NOT NULL,
	Code			VARCHAR(12)		NULL,
	USD				FLOAT			NULL,
	VND				FLOAT			NULL,
	PRIMARY KEY NONCLUSTERED (ExchangeDate, ExchangeId)
) WITH ( MEMORY_OPTIMIZED = ON );
GO
CREATE TYPE t.CurrencyCodes AS TABLE (
	Code			VARCHAR(12)		NOT NULL	PRIMARY KEY NONCLUSTERED
) WITH ( MEMORY_OPTIMIZED = ON );
GRANT EXECUTE ON TYPE::t.CurrencyCodes TO app_exchange;
GO
